
// ============================================
// Persistence
// ============================================

message SaveWorldRequest {
    string name = 1;
}

message SaveWorldResponse {
    bool success = 1;
    string message = 2;
}

message LoadWorldRequest {
    string world_id = 1;
}

message LoadWorldResponse {
    bool success = 1;
    string message = 2;
}

// ============================================
// Stats
// ============================================

message GetColonyStatsRequest {
    string colony_id = 1; // Optional, empty for all
}

message GetColonyStatsResponse {
    repeated ColonyStats stats = 1;
}

message ColonyStats {
    string id = 1;
    string species = 2;
    int32 population = 3;
    float food_stored = 4;
    int32 num_queens = 5;
    int32 num_workers = 6;
    int32 num_soldiers = 7;
}

# ==============================================================================
# SwarmForge .gitignore
# ==============================================================================

# Build & Compilation outputs
**/target/
**/*.class
**/*.log
**/*.jar
**/*.war
**/*.ear
**/node_modules/
**/dist/
**/dist-app/
**/build/
**/bin/
**/dependency-reduced-pom.xml
dependency-reduced-pom.xml

# IDE & Editor files
.idea/
**/*.iml
.vscode/
.project
.classpath
.settings/
.DS_Store
Thumbs.db
hs_err_pid*.log

# Documentation build outputs
**/javadoc/

# Secrets, Keys and Cloud Credentials
.env
.env.*
*.env
*.pem
*.key
*.secret
*.keystore
*.p12
*.jks
credentials.json
secrets.json
*credentials*.json
*service-account*.json
*gcp*.json
google-credentials*.json
client_secret*.json
id_rsa*
*.id_rsa
*.pub

# Database Dumps, State Exports & Checkpoint Dumps
*.sql
*.dump
*.rdb
*.snapshot
snapshots_export.sql
export_*.sql
backup_*.sql

# Benchmark outputs and Profiles
BENCHMARK_REPORT.md
*.prof
*.hprof
**/benchmarks_output/

# Media test outputs & captures
*.mp4
captures/
logs/
**/logs/
in/

# Runtime Data Outputs (Batch Results, Run Logs, Checkpoints)
data/results/*
!data/results/.gitkeep
data/logs/*
!data/logs/.gitkeep
data/checkpoints/*
!data/checkpoints/.gitkeep
